# ZetHub Digital Marketing Automation OS Configuration
# DO NOT COMMIT SECRETS TO GIT

# Environment
APP_ENV=development
TIMEZONE=Asia/Kolkata
PORT=8000
RENDER_SERVICE_PORT=5001

# Primary AI Provider (Vireonix)
VIREONIX_API_URL=https://vireonix.ai/v1/chat/completions
VIREONIX_MODEL=auto

# Fallback AI Provider (Groq / Gemini)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Central Database (MySQL on XAMPP)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=zethub_marketing_os

# n8n Automation Engine
N8N_PORT=5678
N8N_HOST=127.0.0.1
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_USER_FOLDER=D:\marketing_os\n8n_data

# Telegram Bot Alerts & Kill Switch
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Social Media Platform Credentials (Configurable via Admin Dashboard)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_ACCESS_TOKEN=

# Cloudinary (Public Image Hosting for Instagram Graph API)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Marketing (Brevo)
BREVO_API_KEY=
SENDER_EMAIL=hello@zethub.in
SENDER_NAME=ZetHub

# Website & SEO
WEBSITE_URL=https://zethub.in
GITHUB_BLOG_REPO=zethub/website
GITHUB_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=

